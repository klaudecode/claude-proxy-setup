# Vultr server (existing, or create one in NY with scripts/New-VultrServer.ps1)
SSH_HOST=your-vultr-server-ip
SSH_USER=root
# Optional: to create a new server in New York (EWR) with New-VultrServer.ps1
# VULTR_API_KEY=your-api-key
# VULTR_REGION=ewr
# VULTR_PLAN=vc2-1c-1gb
# One of:
SSH_KEY_PATH=C:\Users\You\.ssh\id_ed25519
# SSH_PASSWORD=your-password

# Bright Data proxy (upstream egress from Vultr)
BRIGHT_DATA_HOST=brd.superproxy.io
BRIGHT_DATA_PORT=22225
BRIGHT_DATA_USER=brd-customer-xxx-zone-residential
BRIGHT_DATA_PASS=your-password

# Optional overrides (defaults shown)
WIREGUARD_PORT=51820
XRAY_PORT=1080
WG_CLIENT_IP=10.66.66.2
WG_SERVER_IP=10.66.66.1
